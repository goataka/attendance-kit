{
  "name": "@attendance-kit/backend",
  "version": "0.1.0",
  "private": true,
  "description": "勤怠管理キット - Backend API",
  "scripts": {
    "setup": "npm run setup --prefix ../..",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:debug": "NODE_OPTIONS='--experimental-vm-modules' node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --updateSnapshot",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-integration.json",
    "dev": "nest start --watch",
    "start:local": "npm run dev  &",
    "wait:local": "curl --retry 10 --retry-delay 2 --retry-connrefused --retry-all-errors http://localhost:3000/api/health",
    "generate:openapi": "npx -y ts-node --project ./tsconfig.json tools/generate-openapi.ts",
    "generate": "npm run generate:openapi"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@codegenie/serverless-express": "^5.0.0",
    "aws-lambda": "^1.0.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "backend",
    "attendance",
    "nestjs",
    "api"
  ],
  "author": "goataka",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
