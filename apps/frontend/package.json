{
  "name": "@attendance-kit/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "勤怠管理キット - Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:local": "npm run dev  &",
    "wait:local": "curl --retry 10 --retry-delay 2 --retry-connrefused --retry-all-errors http://localhost:5173",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "pretest:integration": "npx playwright install --with-deps chromium",
    "test:integration": "npx playwright test --update-snapshots",
    "posttest:integration": "git add src/**/*.screenshot.png && git diff --cached --quiet || git commit -m 'スクリーンショットを更新'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test:e2e": "npx playwright test"
  },
  "keywords": [
    "frontend",
    "attendance"
  ],
  "author": "goataka",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
