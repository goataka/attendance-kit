{
  "name": "@attendance-kit/account",
  "version": "1.0.0",
  "description": "AWS CDK account-level infrastructure for attendance-kit (Budget, SNS)",
  "scripts": {
    "setup": "npm run setup --prefix ../..",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:unit": "jest --updateSnapshot",
    "format": "prettier --write \"lib/**/*.ts\" \"bin/**/*.ts\" \"test/**/*.ts\"",
