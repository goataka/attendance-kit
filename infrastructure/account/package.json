  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.x",
    "aws-cdk": "^2.x",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.x",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  },
  "engines": {
    "node": ">=24.0.0"
  }
